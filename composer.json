{
    "name": "carljanzell/filament-feedback",
    "description": "In-app feedback for Filament panels: people tag the modules they mean and how they feel, the team replies in a thread, and a board shows how a release landed.",
    "type": "library",
    "keywords": [
        "filament",
        "filament-plugin",
        "laravel",
        "feedback",
        "support",
        "helpdesk"
    ],
    "homepage": "https://github.com/Darkify19/filament-feedback",
    "license": "MIT",
    "authors": [
        {
            "name": "Carl Janzell",
            "email": "carl.oropesa11@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Darkify19/filament-feedback/issues",
        "source": "https://github.com/Darkify19/filament-feedback"
    },
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.3.53|^4.13.2|^5.8.2"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "livewire/livewire": "^3.5|^4.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "CarlJanzell\\FilamentFeedback\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CarlJanzell\\FilamentFeedback\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CarlJanzell\\FilamentFeedback\\FeedbackServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "format": "pint"
    }
}
